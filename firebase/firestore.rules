rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid}/games/{gameId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && request.resource.data.ownerUid == uid;
    }
    // Starter lobby rules only. Never store secret roles/actions in this shared document.
    // For production, route room joins and all phase/action mutations through Cloud Functions.
    match /rooms/{roomId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid ||
        resource.data.playersUids.hasAny([request.auth.uid]));
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.playersUids == [request.auth.uid];
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','playersUids','updatedAt']) &&
         request.resource.data.playersUids.hasAll(resource.data.playersUids) &&
         request.resource.data.playersUids.size() == resource.data.playersUids.size() + 1 &&
         request.resource.data.playersUids.hasAny([request.auth.uid]) &&
         !resource.data.playersUids.hasAny([request.auth.uid]) &&
         request.resource.data.players.size() == resource.data.players.size() + 1));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
