rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }
    function isRoomMember(roomId) {
      return signedIn() && roomExists(roomId) && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /roomInvites/{code} {
      // Only an authenticated participant can resolve a known invitation code; listing is denied by default.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomId is string;
      allow update, delete: if false;
    }
    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.code is string
        && request.resource.data.name is string;
      allow get: if signedIn() && (request.auth.uid in resource.data.memberUids || resource.data.status == 'lobby');
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      // Host may update room settings. Members may only add their own UID to memberUids.
      allow update: if signedIn() && (
        resource.data.hostUid == request.auth.uid ||
        (!(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids))
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      match /messages/{messageId} {
        allow read, create: if isRoomMember(roomId);
        allow update, delete: if false;
      }
      match /players/{uid} {
        allow read: if isRoomMember(roomId);
        allow create, update: if signedIn() && request.auth.uid == uid && isRoomMember(roomId);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /rounds/{roundId} {
        allow read: if isRoomMember(roomId);
        allow write: if signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
